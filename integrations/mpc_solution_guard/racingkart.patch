+    def _guard_publish_values(self, u, acc, bug_acc_enabled):
+        """Final raw-domain bound in rad; gain conversion remains downstream."""
+        cfg = self._mpc_cfg
+        limit = float(cfg.delta_max)
+        rate = float(cfg.steer_rate_max) / float(cfg.steering_tire_angle_gain_var)
+        dt = 1.0 / float(cfg.control_rate)
+        if (not np.all(np.isfinite([limit, rate, dt, cfg.a_min, cfg.a_max, cfg.v_max]))
+                or limit <= 0 or rate < 0 or dt <= 0 or cfg.a_min >= 0):
+            raise ValueError("INVALID_PUBLISH_LIMITS")
+        previous = float(getattr(self, '_last_published_raw_steer', 0.0))
+        if not np.isfinite(previous) or abs(previous) > limit:
+            previous = 0.0
+        values = np.asarray(u, dtype=float)
+        invalid = (values.shape != (2,) or not np.all(np.isfinite(values))
+                   or not np.isfinite(acc))
+        if not invalid:
+            invalid = abs(values[1]) > limit or values[0] < 0 or values[0] > cfg.v_max
+        if invalid:
+            self.get_logger().error('COMMAND_REJECTED: nonfinite/shape/bounds')
+            values = np.array([0.0, previous])
+            acc = cfg.a_min
+            bug_acc_enabled = False
+        else:
+            values = values.copy()
+        values[1] = np.clip(values[1], max(-limit, previous-rate*dt),
+                            min(limit, previous+rate*dt))
+        self._last_published_raw_steer = float(values[1])
+        return values, float(np.clip(acc, cfg.a_min, cfg.a_max)), bug_acc_enabled
+
