+    def _bounded_steering(self, requested: float) -> float:
+        """Raw tire angle in rad; keep the existing post-publish gain separate."""
+        lower = float(np.arctan(self.input_constraints['umin'][1] * self.model.length))
+        upper = float(np.arctan(self.input_constraints['umax'][1] * self.model.length))
+        if not np.all(np.isfinite([lower, upper, requested, self.previous_steering,
+                                   self.max_steering_rate, self.model.Ts])):
+            raise ValueError("STEERING_NONFINITE")
+        if lower > 0 or upper < 0 or lower >= upper or self.model.Ts <= 0 or self.max_steering_rate < 0:
+            raise ValueError("STEERING_CONFIG")
+        # An already-invalid previous command is not a valid rate-limit anchor.
+        if not lower <= self.previous_steering <= upper:
+            raise ValueError("PREVIOUS_STEERING_OUT_OF_BOUNDS")
+        step = self.max_steering_rate * self.model.Ts
+        return float(np.clip(requested, max(lower, self.previous_steering-step),
+                             min(upper, self.previous_steering+step)))
+
+    def _reject_control(self, reason: str) -> Tuple[np.ndarray, float]:
+        """Zero speed request plus held, bounded raw steer; not a stopping proof."""
+        self.last_control_valid = False
+        self.last_rejection_reason = reason
+        self.infeasibility_counter += 1
+        self.current_prediction = None
+        self.current_prediction_trajectory = None
+        self.current_prediction_contract = (0, 0, False, False)
+        try:
+            steer = self._bounded_steering(float(self.previous_steering))
+        except ValueError:
+            steer = 0.0
+        self.previous_steering = steer
+        self.current_control = np.zeros(self.nu * self.N)
+        self.current_control[1::2] = steer
+        return np.array([0.0, steer]), abs(steer)
 
