<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="simulation" default="true"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="use_obstacle_avoidance" default="true"/>
  <arg name="use_overtake_planner" default="true"/>
  <arg name="pure_pursuit_speed_mps" default="10.0"/>
  <arg name="wall_recovery_enabled" default="true"/>
  <arg name="overtake_horizon_points" default="40"/>
  <arg name="overtake_mpc_health_solve_time_warn_ms" default="200.0"/>
  <arg name="state_lattice_param_path"
       default="$(find-pkg-share state_lattice_overtake_planner)/config/state_lattice_overtake_planner.param.yaml"/>

  <include file="$(find-pkg-share aichallenge_submit_launch)/launch/control/pure_pursuit_mpc_horizon.launch.xml">
    <arg name="simulation" value="$(var simulation)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="use_obstacle_avoidance" value="$(var use_obstacle_avoidance)"/>
    <arg name="use_overtake_planner" value="$(var use_overtake_planner)"/>
    <arg name="overtake_planner_backend" value="state_lattice"/>
    <arg name="pure_pursuit_speed_mps" value="$(var pure_pursuit_speed_mps)"/>
    <arg name="wall_recovery_enabled" value="$(var wall_recovery_enabled)"/>
    <arg name="overtake_horizon_points" value="$(var overtake_horizon_points)"/>
    <arg name="overtake_mpc_health_solve_time_warn_ms" value="$(var overtake_mpc_health_solve_time_warn_ms)"/>
    <arg name="state_lattice_param_path" value="$(var state_lattice_param_path)"/>
  </include>
</launch>
