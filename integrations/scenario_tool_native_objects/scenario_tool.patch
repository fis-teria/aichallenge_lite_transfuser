+"""Native non-vehicle obstacles. Poses use m and explicit yaw_deg in the YAML.
+
+Objects never receive a vehicle index, ROS domain or synthesized V2X position.
+AWSIM owns their prefab dimensions, physics and ground snapping. Size/scale
+parameters are intentionally unsupported because the installed loader ignores them.
+"""
+from __future__ import annotations
+
+import math
+import re
+import json
+from pathlib import Path
+
+from .exitcodes import InvalidScenario
+
+KINDS = ('cone', 'box', 'pole')
+MAX_OBJECTS = 32
+
+
+def validate_objects(document: dict) -> None:
+    objects = document.get('objects', [])
+    if not isinstance(objects, list) or len(objects) > MAX_OBJECTS:
+        raise InvalidScenario('objects は最大32件の配列で指定してください')
+    ids = {document.get('ego', {}).get('id', 'ego')}
+    ids.update(actor['id'] for actor in document.get('actors', []))
+    for item in objects:
+        if not isinstance(item, dict) or set(item) != {'id', 'type', 'pose'}:
+            raise InvalidScenario('物体は id, type, pose のみ指定できます（サイズ変更未対応）')
+        name = item['id']
+        if not isinstance(name, str) or not re.fullmatch(r'[A-Za-z0-9_-]{1,64}', name) or name in ids:
+            raise InvalidScenario(f'物体IDが不正または重複しています: {name!r}')
+        ids.add(name)
+        if item['type'] not in KINDS:
+            raise InvalidScenario(f'物体typeは {KINDS} から選択してください')
+        pose = item['pose']
+        if not isinstance(pose, dict) or set(pose) - {'map_xy', 'awsim_xy', 'reference_s', 'lateral_offset', 'yaw_deg'}:
+            raise InvalidScenario(f'{name}: 物体のposeフィールドが不正です')
+        modes = [key for key in ('map_xy', 'awsim_xy', 'reference_s') if key in pose]
+        if len(modes) != 1 or ('lateral_offset' in pose and modes[0] != 'reference_s'):
+            raise InvalidScenario(f'{name}: 物体位置は map_xy / awsim_xy / reference_s のいずれか1つです')
+        mode = modes[0]
+        values = []
+        if mode.endswith('_xy'):
+            xy = pose[mode]
+            if not isinstance(xy, list) or len(xy) != 2:
+                raise InvalidScenario(f'{name}: {mode} は2要素 [x, y]、単位mです')
+            values.extend(xy)
+        else:
+            values.extend([pose['reference_s'], pose.get('lateral_offset', 0)])
+        values.append(pose.get('yaw_deg', 0))
+        if any(isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v) for v in values):
+            raise InvalidScenario(f'{name}: 座標・向きは有限の数値で指定してください')
+        if 'yaw_deg' in pose and not -180 <= pose['yaw_deg'] <= 180:
+            raise InvalidScenario(f'{name}: yaw_deg は -180〜180 度です')
+
+
+def resolve_objects(document: dict, context, reference_line, transform) -> list[dict]:
+    from .scenario import Entity, _resolve_pose
+    validate_objects(document)
+    result = []
+    for item in document.get('objects', []):
+        pose = dict(item['pose'])
+        if 'yaw_deg' in pose:
+            pose['yaw'] = pose.pop('yaw_deg')
+        elif 'awsim_xy' in pose:
+            pose['yaw'] = 0.0
+        entity = Entity(id=item['id'], role='object', profile=item['type'], spec={'pose': pose})
+        _resolve_pose(entity, [], reference_line, transform, context)
+        assert entity.awsim_pose is not None
+        entry = entity.as_dict()
+        entry.update(type=item['type'], physical_body=True,
+                     collision_checked='official_wall_or_obstacle_counter',
+                     clearance_checked=False, v2x_id=None, domain=None)
+        result.append(entry)
+    return result
+
+
+def native_objects(objects: list[dict]) -> dict:
+    result: dict = {}
+    for item in objects:
+        pose = item['awsim_pose']
+        result.setdefault(item['type'], []).append({
+            'name': item['id'], 'at': [pose['x'], pose['y']], 'yaw': pose['yaw_deg'],
+        })
+    return result
+
+
+def official_contacts(run_dir: Path) -> dict[str, int] | None:
+    """Read only this unique run's official v3 result; absence is unknown."""
+    path = run_dir / 'd1-result-details.json'
+    try:
+        data = json.loads(path.read_text(encoding='utf-8'))
+        if data.get('schema_version') != 'v3' or data.get('vehicle_number') != 1:
+            return None
+        counts = {key: data['penalty_by_kind'][key]['count'] for key in ('crash', 'wall')}
+        if any(type(value) is not int or value < 0 for value in counts.values()):
+            return None
+        return counts
+    except (OSError, ValueError, KeyError, TypeError):
+        return None
+
+
+def spawned_count(run_dir: Path) -> int | None:
+    try:
+        log = (run_dir / 'awsim-player.log').read_text(encoding='utf-8', errors='replace')
+    except OSError:
+        return None
+    matches = re.findall(r'Spawned (\d+) object\(s\) from ', log)
+    return int(matches[-1]) if matches else None
