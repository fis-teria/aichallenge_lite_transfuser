@@ -0,0 +1,138 @@
+"""Native object contract and missing-evidence regressions; no ROS required."""
+from __future__ import annotations
+
+import copy
+import json
+import tempfile
+import unittest
+import threading
+from types import SimpleNamespace
+from unittest.mock import Mock
+from pathlib import Path
+
+from scenario_tool import calibration
+from scenario_tool.compiler import build_awsim_scenario
+from scenario_tool.context import Context
+from scenario_tool.exitcodes import InvalidScenario
+from scenario_tool.objects import official_contacts, spawned_count, validate_objects
+from scenario_tool.scenario import resolve, validate_document
+from tests.test_scenario_tool import square_line, identity_transform
+
+
+def scenario() -> dict:
+    return {'schema_version': 1, 'name': 'objects',
+            'ego': {'submission': {'type': 'current_workspace'},
+                    'pose': {'awsim_xy': [0, 0], 'yaw': 0}},
+            'objects': [{'id': 'box_1', 'type': 'box',
+                         'pose': {'map_xy': [10, 20], 'yaw_deg': 30}}]}
+
+
+class NativeObjectsTest(unittest.TestCase):
+    def test_monitor_joins_callbacks_before_releasing_ros_resources(self):
+        from agent.scenario_monitor import Monitor
+        calls = []
+        monitor = Monitor.__new__(Monitor)
+        monitor.lock = threading.Lock()
+        monitor.executors = [SimpleNamespace(shutdown=lambda **kw: calls.append('stop') or True)]
+        monitor.spin_threads = [SimpleNamespace(join=lambda **kw: calls.append('join'),
+                                               is_alive=lambda: False)]
+        monitor.samples = monitor.events = SimpleNamespace(
+            flush=lambda: calls.append('flush'), close=lambda: calls.append('close'))
+        monitor.node0 = SimpleNamespace(destroy_node=lambda: calls.append('destroy'))
+        monitor.ctx0 = object()
+        monitor.rclpy = SimpleNamespace(shutdown=lambda **kw: calls.append('context'))
+        monitor.shutdown()
+        self.assertEqual(calls[:2], ['stop', 'join'])
+        self.assertLess(calls.index('join'), calls.index('close'))
+        self.assertLess(calls.index('join'), calls.index('destroy'))
+        self.assertEqual(calls[-1], 'context')
+
+    def test_monitor_does_not_destroy_resources_with_a_live_spin_thread(self):
+        from agent.scenario_monitor import Monitor
+        monitor = Monitor.__new__(Monitor)
+        monitor.executors = [SimpleNamespace(shutdown=lambda **kw: True)]
+        monitor.spin_threads = [SimpleNamespace(join=lambda **kw: None, is_alive=lambda: True)]
+        monitor.node0 = SimpleNamespace(destroy_node=Mock())
+        with self.assertRaisesRegex(RuntimeError, 'spin thread'):
+            monitor.shutdown()
+        monitor.node0.destroy_node.assert_not_called()
+
+    def test_finished_file_does_not_hide_monitor_process_crash(self):
+        from scenario_tool.runner import ScenarioRunner
+        status = {'finished': True, 'finish_reason': 'distance_travelled'}
+        self.assertTrue(ScenarioRunner.classify_execution(status, 0)['ok'])
+        for code in (-11, 139, 1, 12, 130):
+            self.assertFalse(ScenarioRunner.classify_execution(status, code)['ok'])
+
+    def test_native_grouping_and_map_to_unity_heading(self):
+        doc = scenario()
+        for kind in ('cone', 'pole'):
+            doc['objects'].append({'id': kind, 'type': kind,
+                                   'pose': {'reference_s': 30, 'lateral_offset': 1}})
+        context = Context()
+        validate_document(doc, context)
+        result = resolve(doc, context, square_line(), identity_transform())
+        native = build_awsim_scenario(result, True)
+        self.assertEqual(set(native['objects']), {'box', 'cone', 'pole'})
+        self.assertEqual(native['objects']['box'][0],
+                         {'name': 'box_1', 'at': [10.0, 20.0], 'yaw': 60.0})
+        self.assertEqual(list(native['vehicles']), ['1'])
+        self.assertEqual(len(result.entities), 1)
+        self.assertTrue(result.calibration_used)
+        self.assertEqual(len(result.to_document()['objects']), 3)
+        self.assertTrue(all(x['v2x_id'] is None and x['domain'] is None for x in result.objects))
+
+    def test_awsim_xy_does_not_require_calibration(self):
+        doc = scenario(); doc['objects'][0]['pose'] = {'awsim_xy': [4, 8], 'yaw_deg': -20}
+        result = resolve(doc, Context(), square_line(), None)
+        self.assertFalse(result.calibration_used)
+        self.assertEqual(build_awsim_scenario(result, False)['objects']['box'][0]['yaw'], -20)
+
+    def test_map_objects_require_calibration_even_with_native_ego(self):
+        with self.assertRaises(InvalidScenario):
+            resolve(scenario(), Context(), square_line(), None)
+
+    def test_ids_types_dimensions_and_finite_values_fail_closed(self):
+        invalid = [
+            {'id': 'ego'}, {'id': 'bad name'}, {'type': 'truck'}, {'size': [1, 1, 1]},
+            {'pose': {'map_xy': [1]}}, {'pose': {'map_xy': [1, 2, 3]}},
+            {'pose': {'map_xy': [float('nan'), 1]}},
+            {'pose': {'awsim_xy': [1, float('inf')]}},
+            {'pose': {'reference_s': True}}, {'pose': {'reference_s': 3, 'yaw_deg': 181}},
+            {'pose': {'reference_s': 3, 'yaw': 1}},
+            {'pose': {'map_xy': [1, 2], 'awsim_xy': [3, 4]}},
+            {'pose': {'map_xy': [1, 2], 'lateral_offset': 1}},
+        ]
+        for change in invalid:
+            with self.subTest(change=change), self.assertRaises(InvalidScenario):
+                doc = scenario(); doc['objects'][0].update(change); validate_document(doc, Context())
+
+    def test_repeated_id_and_limits(self):
+        doc = scenario(); doc['objects'].append(copy.deepcopy(doc['objects'][0]))
+        with self.assertRaises(InvalidScenario): validate_objects(doc)
+        doc['objects'] *= 17
+        with self.assertRaises(InvalidScenario): validate_objects(doc)
+
+    def test_missing_or_bad_official_results_are_unknown(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            self.assertIsNone(official_contacts(root))
+            self.assertIsNone(spawned_count(root))
+            path = root / 'd1-result-details.json'
+            data = {'schema_version': 'v3', 'vehicle_number': 1,
+                    'penalty_by_kind': {'wall': {'count': 0}, 'crash': {'count': 0}}}
+            path.write_text(json.dumps(data))
+            self.assertEqual(official_contacts(root), {'wall': 0, 'crash': 0})
+            data['penalty_by_kind']['wall']['count'] = 1
+            path.write_text(json.dumps(data))
+            self.assertEqual(official_contacts(root)['wall'], 1)
+            data['penalty_by_kind']['wall']['count'] = -1
+            path.write_text(json.dumps(data)); self.assertIsNone(official_contacts(root))
+            data['vehicle_number'] = 2
+            path.write_text(json.dumps(data)); self.assertIsNone(official_contacts(root))
+            (root / 'awsim-player.log').write_text('Spawned 3 object(s) from /output/scenario.yaml\n')
+            self.assertEqual(spawned_count(root), 3)
+
+
+if __name__ == '__main__':
+    unittest.main()
