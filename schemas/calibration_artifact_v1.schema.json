{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aic.example/schemas/calibration_artifact_v1.schema.json",
  "title": "AIC actuator calibration artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_sha256", "source_runs", "source_run_hashes",
    "vehicle_profile_sha256", "steering", "drive", "brake", "promotion"
  ],
  "properties": {
    "schema_version": {"const": "aic_actuator_calibration_v1"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "source_runs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_run_hashes": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "vehicle_profile_sha256": {"$ref": "#/$defs/sha256"},
    "steering": {"$ref": "#/$defs/steering"},
    "drive": {"$ref": "#/$defs/longitudinal"},
    "brake": {"$ref": "#/$defs/longitudinal"},
    "promotion": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "previous_artifact_sha256"],
      "properties": {
        "state": {"enum": ["candidate", "shadow", "promoted", "rolled_back"]},
        "previous_artifact_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "range": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "number"}
    },
    "steering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pure_delay_sec", "time_constant_sec", "gain", "bias_rad",
        "valid_speed_range_mps", "nrmse", "yaw_rate_nrmse",
        "correlation_peak", "dynamic_sample_count", "total_sample_count",
        "excluded_sample_count", "individually_valid", "validity_reasons",
        "source_method"
      ],
      "properties": {
        "pure_delay_sec": {"type": "number", "minimum": 0},
        "time_constant_sec": {"type": "number", "exclusiveMinimum": 0},
        "gain": {"type": "number"},
        "bias_rad": {"type": "number"},
        "valid_speed_range_mps": {"$ref": "#/$defs/range"},
        "nrmse": {"type": "number", "minimum": 0},
        "yaw_rate_nrmse": {"type": "number", "minimum": 0},
        "correlation_peak": {"type": "number", "minimum": -1, "maximum": 1},
        "dynamic_sample_count": {"type": "integer", "minimum": 0},
        "total_sample_count": {"type": "integer", "minimum": 3},
        "excluded_sample_count": {"type": "integer", "minimum": 0},
        "individually_valid": {"type": "boolean"},
        "validity_reasons": {"type": "array", "items": {"type": "string"}},
        "source_method": {"type": "string", "minLength": 1}
      }
    },
    "longitudinal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "pure_delay_sec", "time_constant_sec", "gain", "bias_mps2",
        "valid_speed_range_mps", "command_range_mps2", "rmse_mps2", "nrmse",
        "correlation_peak", "mode_sample_count", "total_sample_count",
        "excluded_actual_accel_count", "individually_valid", "validity_reasons"
      ],
      "properties": {
        "mode": {"enum": ["drive", "brake"]},
        "pure_delay_sec": {"type": "number", "minimum": 0},
        "time_constant_sec": {"type": "number", "exclusiveMinimum": 0},
        "gain": {"type": "number"},
        "bias_mps2": {"type": "number"},
        "valid_speed_range_mps": {"$ref": "#/$defs/range"},
        "command_range_mps2": {"$ref": "#/$defs/range"},
        "rmse_mps2": {"type": "number", "minimum": 0},
        "nrmse": {"type": "number", "minimum": 0},
        "correlation_peak": {"type": "number", "minimum": -1, "maximum": 1},
        "mode_sample_count": {"type": "integer", "minimum": 0},
        "total_sample_count": {"type": "integer", "minimum": 3},
        "excluded_actual_accel_count": {"type": "integer", "minimum": 0},
        "individually_valid": {"type": "boolean"},
        "validity_reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
