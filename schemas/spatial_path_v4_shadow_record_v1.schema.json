        "actual_shape": {
          "oneOf": [
            {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "dtype": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "source_device": {
          "$ref": "#/$defs/nullableId"
        },
        "metadata_reason": {
          "$ref": "#/$defs/reason"
        },
        "float32_le_hex": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{320}$"
        },
        "tensor_hash": {
          "$ref": "#/$defs/hash"
        },
        "geometry": {
