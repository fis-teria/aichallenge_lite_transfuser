          "then": {
            "properties": {
              "forward_invocation_id": {
                "type": "null"
              },
              "output_id": {
                "type": "null"
              },
              "actual_shape": {
                "type": "null"
              },
              "dtype": {
                "type": "null"
              },
              "source_device": {
                "type": "null"
              },
              "failure_stage": {
                "const": "NONE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
