    "record": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "shadow_event"}}}, "then": {"properties": {"record": {"$ref": "#/$defs/event"}}}},
    {"if": {"properties": {"kind": {"const": "offline_join_sidecar"}}}, "then": {"properties": {"record": {"$ref": "#/$defs/sidecar"}}}}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
