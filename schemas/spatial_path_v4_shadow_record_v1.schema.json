        "failure_stage": {
          "enum": [
            "NONE",
            "FORWARD",
            "OUTPUT_CONTRACT",
            "SNAPSHOT"
          ]
        },
        "output_id": {
          "$ref": "#/$defs/nullableId"
        },
        "forward_invocation_id": {
          "$ref": "#/$defs/nullableId"
        },
        "model_xy_m": {
          "oneOf": [
            {
              "$ref": "#/$defs/xy20"
            },
            {
