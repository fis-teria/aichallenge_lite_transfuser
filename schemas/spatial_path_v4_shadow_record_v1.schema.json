        "provider": {"$ref": "#/$defs/reason"}, "interpolation": {"$ref": "#/$defs/reason"}, "age": {"$ref": "#/$defs/duration"},
        "clock_mapping_evidence": {"$ref": "#/$defs/hash"}, "transformed_original_origin_m": {"$ref": "#/$defs/vector3"}, "transformed_xy_m": {"$ref": "#/$defs/finiteXY20"}}
    },
    "event": {
      "type": "object", "additionalProperties": false,
