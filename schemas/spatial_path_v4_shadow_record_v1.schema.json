            }
          },
          "then": {
            "properties": {
              "forward_invocation_id": {
                "$ref": "#/$defs/id"
              },
              "output_id": {
                "type": "null"
              },
              "actual_shape": {
                "type": "null"
              },
              "dtype": {
                "type": "null"
              },
              "source_device": {
                "type": "null"
              },
              "failure_stage": {
                "const": "FORWARD"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "OUTPUT_CONTRACT_ERROR"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "forward_invocation_id": {
                "$ref": "#/$defs/id"
              },
              "output_id": {
                "$ref": "#/$defs/id"
              },
              "failure_stage": {
                "const": "OUTPUT_CONTRACT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "SNAPSHOT_ERROR"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "forward_invocation_id": {
                "$ref": "#/$defs/id"
              },
              "output_id": {
                "$ref": "#/$defs/id"
              },
              "failure_stage": {
                "const": "SNAPSHOT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "NOT_INFERRED",
                  "FORWARD_EXCEPTION",
                  "OUTPUT_CONTRACT_ERROR",
                  "SNAPSHOT_ERROR"
