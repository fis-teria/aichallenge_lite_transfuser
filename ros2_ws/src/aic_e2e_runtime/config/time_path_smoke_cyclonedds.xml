  <Domain Id="any">
    <General>
      <Interfaces><NetworkInterface name="lo"/></Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery><Peers><Peer Address="127.0.0.1"/></Peers></Discovery>
  </Domain>
</CycloneDDS>
