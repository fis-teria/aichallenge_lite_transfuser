Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: AWSIM Vector Map
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map/vector_map_marker
      Value: true
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree: {}
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 1.5
      Name: base_link Axes
      Radius: 0.08
      Reference Frame: base_link
      Value: true
    - Alpha: 1
      Axes Length: 1.5
      Axes Radius: 0.08
      Class: rviz_default_plugins/Pose
      Color: 255; 220; 25
      Enabled: true
      Head Length: 0.3
      Head Radius: 0.15
      Name: Localization Pose
      Shaft Length: 1
      Shaft Radius: 0.08
      Shape: Axes
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /localization/pose
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Color: 255; 85; 85
      Enabled: true
      Name: AWSIM LaserScan
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /sensing/lidar/scan
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 25; 255; 120
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Line Style: Lines
      Line Width: 0.08
      Name: V3 Predicted Trajectory
      Offset:
        X: 0
        Y: 0
        Z: 0.05
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /predicted_trajectory_path
      Value: true
  Enabled: true
  Global Options:
    Background Color: 32; 32; 32
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: AWSIM Map Fixed
      Scale: 18
      Target Frame: map
      X: 89631
      Y: 43128
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Name: Ego Chase
        Scale: 18
        Target Frame: base_link
        X: 6
        Y: 0
Window Geometry:
  Height: 900
  Width: 1400
  X: 100
  Y: 80
